# Copy to .env.local and fill in — see docs/architecture.md for setup steps.
# Never commit the real .env.local (it's already in .gitignore).

# Vercel Postgres (Storage tab in the Vercel dashboard -> .env.local snippet,
# or `vercel env pull` once the project is linked). Any standard Postgres
# connection string works for local dev too.
POSTGRES_URL=

# Telegram bot that receives new-booking alerts. Create one via @BotFather,
# then message it once and read https://api.telegram.org/bot<token>/getUpdates
# to find the chat id. Leave blank to develop without notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
